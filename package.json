{
    "name": "emode",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "test": "turbo run test"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "eslint": "latest",
        "prettier": "latest",
        "turbo": "latest",
        "typescript": "5.9.3"
    },
    "packageManager": "npm@11.3.0",
    "dependencies": {
        "@google/generative-ai": "^0.24.1"
    },
    "overrides": {
        "react": "19.2.3",
        "react-dom": "19.2.3"
    }
}

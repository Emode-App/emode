# emodeAI — web app environment
# Copy to .env.local and fill in. Never commit .env.local.
# Every var below (except the optional block) must also be set in Vercel.

# ── AI ────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required, not optional. /api/generate, /api/entitlements/me,
# /api/dressing-room/*, the Stripe webhook and the admin dashboard all read and
# write entitlements/usage. Without this they fall back to the anon key and RLS
# silently returns zero rows — no error, just a product that appears to work and
# grants nothing. Supabase dashboard > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard once the webhook points at https://<domain>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# ── Abuse limits (both optional; defaults shown) ──────────────────────────────
# Hard per-IP daily generation ceiling. Not the product rate limit — the
# backstop that caps a runaway Gemini bill. Raise if legitimate shared-NAT
# traffic (offices, schools) starts hitting it.
EMODE_IP_DAILY_CEILING=40
# HMAC key for hashing IPs into usage_counters.subject_id, so raw addresses are
# never stored. Any long random string. Falls back to SUPABASE_SERVICE_ROLE_KEY
# if unset. Changing it resets every IP's counter for the day.
EMODE_IP_HASH_SECRET=

# Public origin for emode. Everything user-facing (install snippets, docs, the
# widget modal target, support emails) derives from this via lib/site.ts.
# Defaults to https://emode.style when unset.
NEXT_PUBLIC_EMODE_URL=https://emode.style

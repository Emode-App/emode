// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Postgres (Supabase), not SQLite: session storage must survive on a serverless
// host, where the filesystem is ephemeral. On SQLite every cold start comes up
// with an empty Session table, logging merchants out at random and breaking the
// embedded OAuth handshake.
//
// DATABASE_URL -> pooled connection (pgbouncer, port 6543), used at runtime.
// DIRECT_URL   -> direct connection (port 5432), used for migrations, which
//                 cannot run through the transaction pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // Session storage looks sessions up by shop on every embedded request.
  @@index([shop])
}

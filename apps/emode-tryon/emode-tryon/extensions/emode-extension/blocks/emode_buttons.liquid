{% comment %}
  Try-on keeps the brand gradient — it is the action worth drawing the eye to.
  Dressing Room is deliberately lighter: white fill with a gold shimmer border,
  so the pair reads as premium without either one competing with the theme's own
  Add to cart / Buy it now for the primary-action slot.

  Styles live in a {% comment %}
  The font ships as a data URI inside emode-fonts.css because Shopify theme app
  extensions reject .woff2 in assets/ ("Only these filetypes are supported:
  .jpg, .jpeg, .json, .js, .css, .png, .svg, .wasm"). Regenerate that file with
  scripts/build-font-css.js after changing the font.
{% endcomment %}
{{ 'emode-fonts.css' | asset_url | stylesheet_tag }}

<style> block rather than inline because the shimmer needs
  @keyframes, which inline style attributes cannot express. Class names are
  prefixed to avoid collisions with the merchant's theme CSS.
{% endcomment %}
{%- liquid
  assign max_w = block.settings.max_width | default: 0
  assign align = block.settings.alignment | default: 'left'
  assign wrap_style = 'margin: 12px 0;'
  if max_w > 0
    assign wrap_style = wrap_style | append: ' max-width: ' | append: max_w | append: 'px;'
  endif
  if align == 'center'
    assign wrap_style = wrap_style | append: ' margin-left: auto; margin-right: auto;'
  elsif align == 'right'
    assign wrap_style = wrap_style | append: ' margin-left: auto;'
  endif
-%}
{% comment %}
  As a section-target block, Shopify places this at the section level — which on
  many themes is OUTSIDE the padded container holding Add to cart / Buy it now.
  The result is a row that runs wider than the rest of the column. Theme
  structure varies too much to detect, so width and alignment are merchant
  settings; leaving max width at 0 keeps the previous full-width behaviour.
{% endcomment %}
<style>
  .emode-btn {
    flex: 1;
    min-width: 0;
    padding: 13px 12px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.09em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    /* Fallback chain is chosen to still look deliberate if the webfont fails:
       Futura/Avenir on Apple, Century Gothic on Windows — geometric relatives
       of Syne rather than a generic sans. */
    font-family: 'Syne', 'Futura', 'Avenir Next', 'Century Gothic', system-ui, sans-serif;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }
  .emode-btn:hover { transform: translateY(-1px); }
  .emode-btn:active { transform: translateY(0); }

  .emode-btn--tryon {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #fff;
    border: none;
    box-shadow: 0 3px 12px rgba(99, 102, 241, 0.28);
  }
  .emode-btn--tryon:hover { box-shadow: 0 5px 18px rgba(99, 102, 241, 0.38); }

  /* White fill with an animated gold border. Two background layers: the solid
     white sits in the padding box, the moving gradient in the border box, so the
     border shimmers while the face stays clean. */
  .emode-btn--dressing {
    color: #9a7212;
    border: 1.6px solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(100deg, #b8860b, #f7e07a, #b8860b, #f7e07a, #b8860b) border-box;
    background-size: 100% 100%, 300% 100%;
    animation: emodeShimmer 4s linear infinite;
  }
  .emode-btn--dressing:hover { filter: brightness(1.04); }

  @keyframes emodeShimmer {
    from { background-position: 0% 50%, 0% 50%; }
    to   { background-position: 0% 50%, 300% 50%; }
  }

  /* Respect users who ask the OS to reduce motion — an infinitely animating
     border is exactly the kind of thing that setting exists for. */
  @media (prefers-reduced-motion: reduce) {
    .emode-btn { transition: none; }
    .emode-btn:hover { transform: none; }
    .emode-btn--dressing { animation: none; }
  }
</style>

<div class="emode-buttons" style="{{ wrap_style }} display: flex; gap: 8px;">
  <button
    type="button"
    id="emode-try-on"
    class="emode-btn emode-btn--tryon"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_image | image_url: width: 800, height: 800 }}"
    data-product-price="{{ product.price | money }}"
  >
    ✨ Try This On
  </button>
  <button
    type="button"
    id="emode-add-to-dressing-room"
    class="emode-btn emode-btn--dressing"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_image | image_url: width: 800, height: 800 }}"
    data-product-price="{{ product.price | money }}"
  >
    👗 Dressing Room
  </button>
</div>

<script>
(function() {
  // ── Config ──
  var EMODE_HOST = (function () {
    var raw = '{{ block.settings.emode_host | default: "https://www.emode.style" }}';
    // The apex 308-redirects to www, and a browser treats a redirect on a CORS
    // preflight as fatal — so a merchant who saved "https://emode.style" got
    // working try-on buttons and silently dead impression and order beacons.
    // Nobody can debug that from the theme editor, so repair it here instead of
    // asking them to know. Any other host is left exactly as typed, because a
    // self-hosted or staging deployment is a legitimate thing to point at.
    try {
      var u = new URL(raw);
      if (u.hostname === 'emode.style') u.hostname = 'www.emode.style';
      return u.origin;
    } catch (e) {
      return raw.replace(/\/+$/, '');
    }
  })();
  var SHOP_DOMAIN = '{{ shop.permanent_domain }}';
  var PRODUCT_ID = '{{ product.id }}';

  // ── Shopper identity for try-on → purchase attribution ──
  //
  // This id MUST be minted here, on the merchant's own domain. The try-on modal
  // runs in a cross-origin iframe whose storage browsers partition, so anything
  // stored there is invisible by the time the shopper reaches checkout.
  //
  // It is a random opaque value — no personal data, nothing derived from the
  // shopper — and it exists purely to join a try-on to an order.
  var VISITOR_KEY = 'emode_visitor_id';
  var TRIED_KEY = 'emode_tried_on';

  // ── Consent ──
  //
  // The visitor id is stored in the shopper's browser, which makes it exactly
  // the kind of identifier a consent banner governs. It was being minted on
  // pageview regardless, so on a storefront in the EU or California emode was
  // setting a tracking identifier before anyone had agreed to one — the
  // merchant's compliance problem, created by an app they installed.
  //
  // Shopify already knows the answer. The Customer Privacy API reports what this
  // visitor consented to, and where no consent is required it reports allowed,
  // so gating on it costs nothing on the storefronts that never needed a banner.
  //
  // analyticsProcessingAllowed() is the right question: this identifier exists
  // to measure whether try-ons convert. It is not marketing and is never sold.
  function consentAllowsAttribution() {
    try {
      var api = window.Shopify && window.Shopify.customerPrivacy;
      if (!api || typeof api.analyticsProcessingAllowed !== 'function') {
        // The API is not present. That means the merchant has no consent
        // requirements configured for this visitor, which is Shopify's own
        // default of allowed — not a silent opt-in on our part.
        return true;
      }
      return api.analyticsProcessingAllowed() === true;
    } catch (e) {
      return false; // Cannot establish consent, so do not assume it.
    }
  }

  // Read only. Minting and storing happens in startAttribution, after consent.
  function readVisitorId() {
    try {
      return localStorage.getItem(VISITOR_KEY);
    } catch (e) {
      return null;
    }
  }

  function mintVisitorId() {
    try {
      var id = readVisitorId();
      if (!id) {
        id = (window.crypto && crypto.randomUUID)
          ? crypto.randomUUID()
          : 'v-' + Date.now() + '-' + Math.random().toString(36).slice(2, 11);
        localStorage.setItem(VISITOR_KEY, id);
      }
      return id;
    } catch (e) {
      // Private browsing or storage disabled — attribution is simply skipped.
      return null;
    }
  }

  // Withdrawing consent has to actually remove the thing, not merely stop
  // adding to it. An identifier that survives a "no" is the same identifier.
  function forgetVisitor() {
    try {
      localStorage.removeItem(VISITOR_KEY);
      localStorage.removeItem(TRIED_KEY);
    } catch (e) {}
    VISITOR_ID = null;
  }

  var VISITOR_ID = null;

  // Writes the visitor id onto the Shopify cart. Shopify carries cart
  // attributes through to the order, where the orders/create webhook reads it
  // back — that is the whole attribution chain.
  //
  // The underscore prefix keeps it out of the customer's order confirmation and
  // the merchant's order display.
  //
  // Setting it on the cart (rather than hooking each theme's add-to-cart form)
  // is deliberate: cart attributes persist for the session, so anything added
  // afterwards carries the id regardless of how the theme adds to cart. No
  // theme-specific DOM assumptions, nothing to break on an unusual template.
  function tagCart() {
    if (!VISITOR_ID) return;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributes: { _emode_vid: VISITOR_ID } })
    }).catch(function () { /* never let analytics break the storefront */ });
  }

  // Records that this shopper SAW the try-on button — the control group that
  // makes "try-on shoppers convert at X%" a meaningful claim rather than a
  // number with nothing to compare against. Deduplicated server-side.
  function logImpression() {
    if (!VISITOR_ID) return;
    fetch(EMODE_HOST + '/api/impression', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ shop: SHOP_DOMAIN, visitorId: VISITOR_ID, productId: PRODUCT_ID }),
      keepalive: true
    }).catch(function () {});
  }

  // Everything that touches the visitor id, behind one gate.
  function startAttribution() {
    if (VISITOR_ID) return;               // already running
    if (!consentAllowsAttribution()) return;

    VISITOR_ID = mintVisitorId();
    if (!VISITOR_ID) return;

    logImpression();

    // A returning shopper who has tried on before may land with a fresh cart,
    // so re-tag on load. First-time visitors get tagged when they open the modal
    // — avoids a cart write on every product pageview for people who never
    // engage.
    try {
      if (localStorage.getItem(TRIED_KEY)) tagCart();
    } catch (e) {}
  }

  // Load Shopify's consent API if the theme has not already, then decide. The
  // callback fires either way, so a theme without the feature still starts.
  try {
    if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures(
        [{ name: 'consent-tracking-api', version: '0.1' }],
        function () { startAttribution(); }
      );
    } else {
      startAttribution();
    }
  } catch (e) {
    startAttribution();
  }

  // A shopper who accepts after landing should be attributed from that moment,
  // and one who declines should stop being — including losing the id already
  // stored, which is the part that makes the answer mean something.
  document.addEventListener('visitorConsentCollected', function () {
    if (consentAllowsAttribution()) startAttribution();
    else forgetVisitor();
  });

  // ── Match the theme's buy buttons ──
  //
  // As a section-target block, Shopify inserts this at the section level, which
  // on most themes sits outside the padded container holding Add to cart /
  // Buy it now. The result is a row that runs wider than everything around it.
  //
  // Rather than make every merchant hand-tune a width slider, measure the
  // theme's own add-to-cart control and match its width and left edge. Purely
  // cosmetic and wrapped in try/catch — if the selectors miss, the row simply
  // stays full width as before.
  function matchBuyButtonWidth() {
    // Skip when the merchant has set an explicit width in the theme editor.
    if ({{ block.settings.max_width | default: 0 }} > 0) return;

    var wrap = document.querySelector('.emode-buttons');
    if (!wrap || !wrap.parentElement) return;

    // Ordered most- to least-specific. button[name="add"] is the Shopify
    // convention and works on the overwhelming majority of themes.
    var ref = document.querySelector(
      '.product-form__buttons, .shopify-payment-button, form[action*="/cart/add"] button[name="add"], button[name="add"]'
    );
    if (!ref) return;

    var refBox = ref.getBoundingClientRect();
    var parentBox = wrap.parentElement.getBoundingClientRect();
    if (!refBox.width || !parentBox.width) return;

    // Ignore absurd measurements (hidden elements, sticky bars, drawers).
    if (refBox.width < 80 || refBox.width > parentBox.width + 4) return;

    wrap.style.maxWidth = Math.round(refBox.width) + 'px';
    var offset = Math.round(refBox.left - parentBox.left);
    if (offset > 0) wrap.style.marginLeft = offset + 'px';
  }

  function scheduleMatch() {
    try { matchBuyButtonWidth(); } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleMatch);
  } else {
    scheduleMatch();
  }
  // Themes that render the buy buttons asynchronously (or swap them on variant
  // change) settle shortly after load.
  setTimeout(scheduleMatch, 400);
  setTimeout(scheduleMatch, 1200);

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(scheduleMatch, 150);
  });

  // ── Build modal URL from button data attributes ──
  function buildModalUrl(btn, tab) {
    var d = btn.dataset;
    var params = new URLSearchParams({
      shop: SHOP_DOMAIN,
      product: d.productId || '',
      variant: d.variantId || '',
      title: d.productTitle || '',
      image: d.productImage || '',
      price: d.productPrice || '',
      tab: tab || 'try-on',
      source: 'shopify',
      // Threaded to /api/generate so the generation row carries the same id
      // that will appear on the order.
      vid: VISITOR_ID || ''
    });
    return EMODE_HOST + '/modal?' + params.toString();
  }

  // ── Create & show iframe overlay ──
  function openEmodeModal(url) {
    // Prevent duplicates
    if (document.getElementById('emode-overlay')) return;

    // Backdrop
    var overlay = document.createElement('div');
    overlay.id = 'emode-overlay';
    overlay.style.cssText = 'position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;padding:16px;';

    var backdrop = document.createElement('div');
    backdrop.style.cssText = 'position:absolute;inset:0;background:rgba(10,10,10,0.5);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:opacity 0.3s ease;';
    backdrop.addEventListener('click', closeEmodeModal);
    overlay.appendChild(backdrop);

    // Modal container
    var modal = document.createElement('div');
    modal.style.cssText = 'position:relative;width:100%;max-width:1100px;height:90vh;max-height:850px;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,0.3);animation:emodeSlideIn 0.3s ease;';
    overlay.appendChild(modal);

    // Close button
    var closeBtn = document.createElement('button');
    closeBtn.innerHTML = '✕';
    closeBtn.style.cssText = 'position:absolute;top:16px;right:16px;z-index:10;width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,0.06);border:none;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.2s;';
    closeBtn.addEventListener('click', closeEmodeModal);
    closeBtn.addEventListener('mouseover', function() { this.style.background = 'rgba(0,0,0,0.12)'; });
    closeBtn.addEventListener('mouseout', function() { this.style.background = 'rgba(0,0,0,0.06)'; });
    modal.appendChild(closeBtn);

    // Iframe
    var iframe = document.createElement('iframe');
    iframe.src = url;
    iframe.style.cssText = 'width:100%;height:100%;border:none;';
    iframe.setAttribute('allow', 'camera;microphone');
    modal.appendChild(iframe);

    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';

    // Inject animation keyframes
    if (!document.getElementById('emode-keyframes')) {
      var style = document.createElement('style');
      style.id = 'emode-keyframes';
      style.textContent = '@keyframes emodeSlideIn{from{opacity:0;transform:scale(0.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}';
      document.head.appendChild(style);
    }
  }

  function closeEmodeModal() {
    var overlay = document.getElementById('emode-overlay');
    if (overlay) {
      overlay.remove();
      document.body.style.overflow = '';
    }
  }

  // ── Listen for close messages from iframe ──
  window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'emode:close') {
      closeEmodeModal();
    }
    // Handle add-to-cart from iframe
    if (e.data && e.data.type === 'emode:add-to-cart') {
      // The modal now sends `items` for a whole look. `variantId` is still read
      // as a fallback so a storefront running an older published version of this
      // block keeps working after the modal updates — they deploy separately.
      var list = Array.isArray(e.data.items) && e.data.items.length
        ? e.data.items
        : (e.data.variantId ? [{ variantId: e.data.variantId }] : []);

      var cartItems = list
        .map(function (it) { return parseInt(it && it.variantId, 10); })
        .filter(function (id) { return !isNaN(id); })
        // /cart/add.js rejects the whole request if any line is a duplicate, so
        // one garment selected twice would lose the entire look.
        .filter(function (id, i, all) { return all.indexOf(id) === i; })
        .map(function (id) { return { id: id, quantity: 1 }; });

      // Every branch below says something. This used to be a bare .then that
      // closed the modal whatever came back: a 422 for a sold-out or invalid
      // variant looked exactly like a success, the modal shut, and the shopper
      // went to a cart with nothing new in it. A silent failure in the buy
      // button is the most expensive kind there is.
      if (!cartItems.length) {
        console.warn('[emodeAI] Add to cart: nothing to add.', {
          received: e.data.items, fallbackVariantId: e.data.variantId
        });
        return;
      }
      if (!window.Shopify || !window.Shopify.shop) {
        console.warn('[emodeAI] Add to cart: not a Shopify storefront context.');
        return;
      }

      // Locale-aware. Hardcoding '/cart/add.js' 404s on a store served under a
      // locale prefix such as /fr, because the cart routes move with it.
      var root = (window.Shopify.routes && window.Shopify.routes.root) || '/';

      /**
       * Show the shopper what just happened.
       *
       * The old code called window.refreshCart, which is not a Shopify API and
       * no theme defines — so the request succeeded, the cart really did change,
       * and absolutely nothing on screen moved. The shopper concluded the button
       * was broken, which is exactly what happened here.
       *
       * Standard storefront actions are the supported answer: openCart opens a
       * drawer if the theme has one and redirects to the cart page if it does
       * not. Where the runtime is missing, going to the cart is the honest
       * fallback — they pressed a button called Purchase Look.
       */
      /**
       * Add, then show the drawer — without leaving the product page.
       *
       * Three attempts, best first, because no single one works on every theme.
       *
       * 1. Shopify.actions.updateCart. The sanctioned way for an app to change
       *    a cart: the theme refreshes its own UI and the standard events fire
       *    for us. This was tried before and appeared to do nothing, because it
       *    takes a Storefront API merchandiseId — a gid://shopify/ProductVariant/…
       *    string — and was handed the bare numeric id cart/add.js wants. The
       *    call resolved, the cart never changed, and the drawer opened empty.
       *    Same approach, correct id.
       *
       * 2. cart/add.js asking for the drawer sections back. Shopify re-renders
       *    them server-side and returns the markup, which is how Dawn and the
       *    themes derived from it refresh without a reload. Swapping that markup
       *    in is what makes the drawer show the truth.
       *
       * 3. Navigating to the cart. Correct everywhere and disruptive everywhere,
       *    so it is the floor, not the plan — a shopper mid-outfit should not be
       *    thrown off the product page.
       */
      function openDrawer() {
        var actions = window.Shopify.actions;
        if (actions && typeof actions.openCart === 'function') {
          try { actions.openCart(); return true; } catch (err) { /* try the DOM */ }
        }
        // Dawn and its descendants expose a <cart-drawer> element with open().
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.open === 'function') {
          try { drawer.open(); return true; } catch (err) { /* fall through */ }
        }
        return false;
      }

      function swapSections(sections) {
        if (!sections) return false;
        var swapped = false;
        Object.keys(sections).forEach(function (name) {
          var markup = sections[name];
          if (!markup) return;
          try {
            var parsed = new DOMParser().parseFromString(markup, 'text/html');
            // The section renders wrapped in its own container; find the same
            // node in the live page and replace only its contents.
            var incoming = parsed.querySelector('.shopify-section, #shopify-section-' + name) || parsed.body;
            var target = document.getElementById('shopify-section-' + name)
              || document.querySelector('#CartDrawer')
              || document.getElementById(name);
            if (target && incoming) {
              target.innerHTML = incoming.innerHTML;
              swapped = true;
            }
          } catch (err) { /* a theme that does not match this shape */ }
        });
        return swapped;
      }

      var actions = window.Shopify.actions;
      if (actions && typeof actions.updateCart === 'function') {
        actions.updateCart({
          lines: cartItems.map(function (it) {
            // Storefront API ids are gids, not the numeric form cart/add.js uses.
            return {
              merchandiseId: 'gid://shopify/ProductVariant/' + it.id,
              quantity: it.quantity
            };
          })
        }).then(function () {
          console.log('[emodeAI] Added to cart via standard actions:', cartItems);
          closeEmodeModal();
          openDrawer();
        }).catch(function (err) {
          console.warn('[emodeAI] updateCart failed, falling back to cart/add.js:', err);
          rawAdd();
        });
      } else {
        rawAdd();
      }

      function rawAdd() {
        fetch(root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cartItems,
            // Ask for the drawer back, re-rendered with the new contents.
            sections: 'cart-drawer,cart-icon-bubble',
            sections_url: window.location.pathname
          })
        }).then(function (res) {
          if (!res.ok) {
            // Shopify explains the refusal in the body — sold out, no such
            // variant, quantity unavailable. Worth reading rather than guessing.
            return res.text().then(function (body) {
              console.error('[emodeAI] Add to cart refused by Shopify.',
                res.status, body, 'sent:', cartItems);
              // Deliberately left open: closing it implies it worked.
            });
          }
          return res.json().then(function (data) {
            console.log('[emodeAI] Added to cart:', cartItems);
            closeEmodeModal();

            var refreshed = swapSections(data && data.sections);
            var opened = openDrawer();

            // Only leave the page if the drawer could not be made truthful.
            // Showing a stale "your cart is empty" is worse than navigating.
            if (!refreshed && !opened) {
              window.location.href = root + 'cart';
            }
          });
        }).catch(function (err) {
          console.error('[emodeAI] Add to cart failed:', err, 'sent:', cartItems);
        });
      }
    }
  });

  // Escape key to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeEmodeModal();
  });

  // ── Button handlers ──
  // Opening the modal is the engagement signal: tag the cart now so any
  // subsequent purchase is attributable, and remember it for return visits.
  function onEngage() {
    // Engagement is a stronger consent signal than a pageview, but it is still
    // not consent. Someone who declined tracking and then tries a jacket on has
    // declined tracking - the try-on works, it simply is not attributed.
    if (!consentAllowsAttribution()) return;

    // First engagement is also the first moment attribution is worth starting,
    // for a visitor who arrived before the consent API had answered.
    startAttribution();
    if (!VISITOR_ID) return;

    try { localStorage.setItem(TRIED_KEY, '1'); } catch (e) {}
    tagCart();
  }

  document.getElementById('emode-try-on').addEventListener('click', function() {
    onEngage();
    openEmodeModal(buildModalUrl(this, 'try-on'));
  });

  document.getElementById('emode-add-to-dressing-room').addEventListener('click', function() {
    onEngage();
    openEmodeModal(buildModalUrl(this, 'dressing-room'));
  });
})();
</script>

{% schema %}
{
  "name": "emodeAI Buttons",
  "target": "section",
  "enabled_on": {

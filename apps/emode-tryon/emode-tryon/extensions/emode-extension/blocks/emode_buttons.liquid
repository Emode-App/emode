{% comment %}
  Try-on keeps the brand gradient — it is the action worth drawing the eye to.
  Dressing Room is deliberately lighter: white fill with a gold shimmer border,
  so the pair reads as premium without either one competing with the theme's own
  Add to cart / Buy it now for the primary-action slot.

  Styles live in a {% comment %}
  The font ships as a data URI inside emode-fonts.css because Shopify theme app
  extensions reject .woff2 in assets/ ("Only these filetypes are supported:
  .jpg, .jpeg, .json, .js, .css, .png, .svg, .wasm"). Regenerate that file with
  scripts/build-font-css.js after changing the font.
{% endcomment %}
{{ 'emode-fonts.css' | asset_url | stylesheet_tag }}

<style> block rather than inline because the shimmer needs
  @keyframes, which inline style attributes cannot express. Class names are
  prefixed to avoid collisions with the merchant's theme CSS.
{% endcomment %}
{%- liquid
  assign max_w = block.settings.max_width | default: 0
  assign align = block.settings.alignment | default: 'left'
  assign wrap_style = 'margin: 12px 0;'
  if max_w > 0
    assign wrap_style = wrap_style | append: ' max-width: ' | append: max_w | append: 'px;'
  endif
  if align == 'center'
    assign wrap_style = wrap_style | append: ' margin-left: auto; margin-right: auto;'
  elsif align == 'right'
    assign wrap_style = wrap_style | append: ' margin-left: auto;'
  endif
-%}
{% comment %}
  As a section-target block, Shopify places this at the section level — which on
  many themes is OUTSIDE the padded container holding Add to cart / Buy it now.
  The result is a row that runs wider than the rest of the column. Theme
  structure varies too much to detect, so width and alignment are merchant
  settings; leaving max width at 0 keeps the previous full-width behaviour.
{% endcomment %}
<style>
  .emode-btn {
    flex: 1;
    min-width: 0;
    padding: 13px 12px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.09em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    /* Fallback chain is chosen to still look deliberate if the webfont fails:
       Futura/Avenir on Apple, Century Gothic on Windows — geometric relatives
       of Syne rather than a generic sans. */
    font-family: 'Syne', 'Futura', 'Avenir Next', 'Century Gothic', system-ui, sans-serif;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }
  .emode-btn:hover { transform: translateY(-1px); }
  .emode-btn:active { transform: translateY(0); }

  .emode-btn--tryon {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #fff;
    border: none;
    box-shadow: 0 3px 12px rgba(99, 102, 241, 0.28);
  }
  .emode-btn--tryon:hover { box-shadow: 0 5px 18px rgba(99, 102, 241, 0.38); }

  /* White fill with an animated gold border. Two background layers: the solid
     white sits in the padding box, the moving gradient in the border box, so the
     border shimmers while the face stays clean. */
  .emode-btn--dressing {
    color: #9a7212;
    border: 1.6px solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(100deg, #b8860b, #f7e07a, #b8860b, #f7e07a, #b8860b) border-box;
    background-size: 100% 100%, 300% 100%;
    animation: emodeShimmer 4s linear infinite;
  }
  .emode-btn--dressing:hover { filter: brightness(1.04); }

  @keyframes emodeShimmer {
    from { background-position: 0% 50%, 0% 50%; }
    to   { background-position: 0% 50%, 300% 50%; }
  }

  /* Respect users who ask the OS to reduce motion — an infinitely animating
     border is exactly the kind of thing that setting exists for. */
  @media (prefers-reduced-motion: reduce) {
    .emode-btn { transition: none; }
    .emode-btn:hover { transform: none; }
    .emode-btn--dressing { animation: none; }
  }
</style>

<div class="emode-buttons" style="{{ wrap_style }} display: flex; gap: 8px;">
  <button
    type="button"
    id="emode-try-on"
    class="emode-btn emode-btn--tryon"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_image | image_url: width: 800, height: 800 }}"
    data-product-price="{{ product.price | money }}"
  >
    ✨ Try This On
  </button>
  <button
    type="button"
    id="emode-add-to-dressing-room"
    class="emode-btn emode-btn--dressing"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_image | image_url: width: 800, height: 800 }}"
    data-product-price="{{ product.price | money }}"
  >
    👗 Dressing Room
  </button>
</div>

<script>
(function() {
  // ── Config ──
  var EMODE_HOST = '{{ block.settings.emode_host | default: "https://emode.style" }}';
  var SHOP_DOMAIN = '{{ shop.permanent_domain }}';
  var PRODUCT_ID = '{{ product.id }}';

  // ── Shopper identity for try-on → purchase attribution ──
  //
  // This id MUST be minted here, on the merchant's own domain. The try-on modal
  // runs in a cross-origin iframe whose storage browsers partition, so anything
  // stored there is invisible by the time the shopper reaches checkout.
  //
  // It is a random opaque value — no personal data, nothing derived from the
  // shopper — and it exists purely to join a try-on to an order.
  var VISITOR_KEY = 'emode_visitor_id';
  var TRIED_KEY = 'emode_tried_on';

  function getVisitorId() {
    try {
      var id = localStorage.getItem(VISITOR_KEY);
      if (!id) {
        id = (window.crypto && crypto.randomUUID)
          ? crypto.randomUUID()
          : 'v-' + Date.now() + '-' + Math.random().toString(36).slice(2, 11);
        localStorage.setItem(VISITOR_KEY, id);
      }
      return id;
    } catch (e) {
      // Private browsing or storage disabled — attribution is simply skipped.
      return null;
    }
  }

  var VISITOR_ID = getVisitorId();

  // Writes the visitor id onto the Shopify cart. Shopify carries cart
  // attributes through to the order, where the orders/create webhook reads it
  // back — that is the whole attribution chain.
  //
  // The underscore prefix keeps it out of the customer's order confirmation and
  // the merchant's order display.
  //
  // Setting it on the cart (rather than hooking each theme's add-to-cart form)
  // is deliberate: cart attributes persist for the session, so anything added
  // afterwards carries the id regardless of how the theme adds to cart. No
  // theme-specific DOM assumptions, nothing to break on an unusual template.
  function tagCart() {
    if (!VISITOR_ID) return;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributes: { _emode_vid: VISITOR_ID } })
    }).catch(function () { /* never let analytics break the storefront */ });
  }

  // Records that this shopper SAW the try-on button — the control group that
  // makes "try-on shoppers convert at X%" a meaningful claim rather than a
  // number with nothing to compare against. Deduplicated server-side.
  function logImpression() {
    if (!VISITOR_ID) return;
    fetch(EMODE_HOST + '/api/impression', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ shop: SHOP_DOMAIN, visitorId: VISITOR_ID, productId: PRODUCT_ID }),
      keepalive: true
    }).catch(function () {});
  }

  logImpression();

  // A returning shopper who has tried on before may land with a fresh cart, so
  // re-tag on load. First-time visitors get tagged when they open the modal —
  // avoids a cart write on every product pageview for people who never engage.
  try {
    if (localStorage.getItem(TRIED_KEY)) tagCart();
  } catch (e) {}

  // ── Build modal URL from button data attributes ──
  function buildModalUrl(btn, tab) {
    var d = btn.dataset;
    var params = new URLSearchParams({
      shop: SHOP_DOMAIN,
      product: d.productId || '',
      variant: d.variantId || '',
      title: d.productTitle || '',
      image: d.productImage || '',
      price: d.productPrice || '',
      tab: tab || 'try-on',
      source: 'shopify',
      // Threaded to /api/generate so the generation row carries the same id
      // that will appear on the order.
      vid: VISITOR_ID || ''
    });
    return EMODE_HOST + '/modal?' + params.toString();
  }

  // ── Create & show iframe overlay ──
  function openEmodeModal(url) {
    // Prevent duplicates
    if (document.getElementById('emode-overlay')) return;

    // Backdrop
    var overlay = document.createElement('div');
    overlay.id = 'emode-overlay';
    overlay.style.cssText = 'position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;padding:16px;';

    var backdrop = document.createElement('div');
    backdrop.style.cssText = 'position:absolute;inset:0;background:rgba(10,10,10,0.5);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:opacity 0.3s ease;';
    backdrop.addEventListener('click', closeEmodeModal);
    overlay.appendChild(backdrop);

    // Modal container
    var modal = document.createElement('div');
    modal.style.cssText = 'position:relative;width:100%;max-width:1100px;height:90vh;max-height:850px;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,0.3);animation:emodeSlideIn 0.3s ease;';
    overlay.appendChild(modal);

    // Close button
    var closeBtn = document.createElement('button');
    closeBtn.innerHTML = '✕';
    closeBtn.style.cssText = 'position:absolute;top:16px;right:16px;z-index:10;width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,0.06);border:none;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.2s;';
    closeBtn.addEventListener('click', closeEmodeModal);
    closeBtn.addEventListener('mouseover', function() { this.style.background = 'rgba(0,0,0,0.12)'; });
    closeBtn.addEventListener('mouseout', function() { this.style.background = 'rgba(0,0,0,0.06)'; });
    modal.appendChild(closeBtn);

    // Iframe
    var iframe = document.createElement('iframe');
    iframe.src = url;
    iframe.style.cssText = 'width:100%;height:100%;border:none;';
    iframe.setAttribute('allow', 'camera;microphone');
    modal.appendChild(iframe);

    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';

    // Inject animation keyframes
    if (!document.getElementById('emode-keyframes')) {
      var style = document.createElement('style');
      style.id = 'emode-keyframes';
      style.textContent = '@keyframes emodeSlideIn{from{opacity:0;transform:scale(0.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}';
      document.head.appendChild(style);
    }
  }

  function closeEmodeModal() {
    var overlay = document.getElementById('emode-overlay');
    if (overlay) {
      overlay.remove();
      document.body.style.overflow = '';
    }
  }

  // ── Listen for close messages from iframe ──
  window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'emode:close') {
      closeEmodeModal();
    }
    // Handle add-to-cart from iframe
    if (e.data && e.data.type === 'emode:add-to-cart') {
      var variantId = e.data.variantId;
      if (variantId && window.Shopify && window.Shopify.shop) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
        }).then(function() {
          closeEmodeModal();
          // Refresh cart drawer if available
          if (typeof window.refreshCart === 'function') window.refreshCart();
        });
      }
    }
  });

  // Escape key to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeEmodeModal();
  });

  // ── Button handlers ──
  // Opening the modal is the engagement signal: tag the cart now so any
  // subsequent purchase is attributable, and remember it for return visits.
  function onEngage() {
    try { localStorage.setItem(TRIED_KEY, '1'); } catch (e) {}
    tagCart();
  }

  document.getElementById('emode-try-on').addEventListener('click', function() {
    onEngage();
    openEmodeModal(buildModalUrl(this, 'try-on'));
  });

  document.getElementById('emode-add-to-dressing-room').addEventListener('click', function() {
    onEngage();
    openEmodeModal(buildModalUrl(this, 'dressing-room'));
  });
})();
</script>

{% schema %}
{
  "name": "emodeAI Buttons",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "Match your Add to cart button's width. 0 = full width of the container."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "emode_host",
      "label": "Emode App URL",
      "default": "https://emode.style",
      "info": "The URL of your emodeAI instance. Change to localhost:3000 for development."
    }
  ]
}
{% endschema %}

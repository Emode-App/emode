{
    "manifest_version": 3,
    "name": "emodeAI | Universal Virtual Try-On",
    "version": "1.0.0",
    "description": "Try on clothing across any website with AI.",
    "permissions": [
        "sidePanel",
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Open emodeAI",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "detect.js",
                "content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://emode.style/*",
                "https://*.emode.style/*",
                "http://localhost:3000/*"
            ],
            "js": [
                "auth-bridge.js"
            ],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}

{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env.*local"
    ],
    "tasks": {
        // Tests need no build output and no env; they run against source.
        "test": {
            "outputs": []
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            // Turborepo only forwards env vars declared here. Anything set in
            // Vercel but missing from this list arrives undefined at build
            // time — that is how a correctly-configured project still fails
            // with "Neither apiKey nor config.authenticator provided".
            // NEXT_PUBLIC_* would come through via framework inference, but is
            // listed explicitly so the build hash tracks it too.
            "env": [
                "NEXT_PUBLIC_EMODE_URL",
                "GOOGLE_API_KEY",
                "NEXT_PUBLIC_SUPABASE_URL",
                "NEXT_PUBLIC_SUPABASE_ANON_KEY",
                "SUPABASE_SERVICE_ROLE_KEY",
                "STRIPE_SECRET_KEY",
                "STRIPE_WEBHOOK_SECRET",
                "EMODE_IP_DAILY_CEILING",
                "EMODE_IP_HASH_SECRET"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}